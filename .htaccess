<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-SSL} !on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Enviar todo internamente a la carpeta "public" (el front controller de Laravel),
    # sin que "public/" aparezca nunca en la URL del navegador. Nota: las peticiones que
    # ya empiezan con "/public/" las maneja public/.htaccess directamente (Apache entra
    # a esa carpeta real antes de volver a evaluar estas reglas), por eso la redirección
    # que limpia "/public/..." vive allá y no aquí.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
