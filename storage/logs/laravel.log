      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Lunch and dinner&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Flight: Brazil - Lima - Brazil&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Flight: Lima - Cusco - Lima&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Flight: Juliaca - Lima&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Travel insurance&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Other services not specified above&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
