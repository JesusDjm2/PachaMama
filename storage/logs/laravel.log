      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Airport / Hotel / Airport transfers (Cusco)&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Tourist transportation for each excursion&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Entrance to all tourist sites&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Professional guides for each excursion&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Tours in Lima: Modern and Colonial City Tour&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Tour in Cusco: Archaeological City Tour, Sacred Valley, and Machu Picchu&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Tours in Puno: Lake Titicaca, Uros Floating Islands, and Taquile&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Sun Route Tour: Cusco / Puno&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Executive bus Puno / Cusco&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;2 nights of hotel accommodation in Lima&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;4 nights of hotel accommodation in Cusco&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;2 nights of hotel accommodation in Puno&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;1-day entrance to Machu Picchu&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;2 train tickets in tourist class: Round trip to Aguas Calientes&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;1 bus ticket from Aguas Calientes to Machu Picchu and vice versa&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Transfer from Cusco to Ollantaytambo train station and back to Cusco&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"1261 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
