  #<span class=sf-dump-protected title=\"Protected property\">original</span>: <span class=sf-dump-note>array:20</span> [<samp data-depth=2 class=sf-dump-compact>
    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>7</span>
    \"<span class=sf-dump-key>tour_id</span>\" => <span class=sf-dump-num>7</span>
    \"<span class=sf-dump-key>nombre</span>\" => \"<span class=sf-dump-str title=\"23 characters\">Per&#250; Package for 9 days</span>\"
    \"<span class=sf-dump-key>descripcion</span>\" => \"<span class=sf-dump-str title=\"80 characters\">9 days, an ideal package to explore the main tourist attractions of the country.</span>\"
    \"<span class=sf-dump-key>contenido</span>\" => \"<span class=sf-dump-str title=\"731 characters\">&lt;p&gt;The trip starts in Lima, visiting &lt;strong&gt;Huaca Pucllana&lt;/strong&gt;, Plaza de Armas, Plaza San Mart&amp;iacute;n, Government Palace, San Francisco Church, San Isidro, Miraflores, Love Park, and Larcomar, with an optional visit to the &lt;strong&gt;Magic Water Circuit&lt;/strong&gt;. Next, explore Cusco, including &lt;strong&gt;Sacsayhuam&amp;aacute;n, Qenqo, Pucapucara, Tambomachay, and the Sacred Valley sites of Pisac&lt;/strong&gt;, Ollantaytambo, and Chinchero, with an optional overnight in Aguas Calientes near &lt;strong&gt;Machu Picchu&lt;/strong&gt;. The &amp;quot;Route of the Sun&amp;quot; from Cusco to Puno features Andahuaylillas, Raqchi, La Raya, and Pucar&amp;aacute; Museum. The journey ends with a visit to Lake Titicaca, including the Uros and Taquile Islands.&lt;/p&gt;</span>\"
    \"<span class=sf-dump-key>resumen</span>\" => \"\"\"
      <span class=sf-dump-str title=\"696 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 01:&lt;/strong&gt; ARRIVAL IN LIMA.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 02:&lt;/strong&gt; LIMA - CITY TOUR OF COLONIAL AND MODERN AREAS.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 03:&lt;/strong&gt; FLIGHT FROM LIMA TO CUSCO / ARCHAEOLOGICAL CITY TOUR.&amp;nbsp;&amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 04:&lt;/strong&gt; CUSCO - SACRED VALLEY OF THE INCAS.&amp;nbsp;&amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 05:&lt;/strong&gt; CUSCO - MACHU PICCHU FULL DAY.&amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 06:&lt;/strong&gt; CUSCO - PUNO / ROUTE OF THE SUN.&amp;nbsp;&amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 07:&lt;/strong&gt; PUNO - LAKE TITICACA.&amp;nbsp;&amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 08:&lt;/strong&gt; PUNO - CUSCO.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;&lt;strong&gt;DAY 09:&lt;/strong&gt; FLIGHT FROM CUSCO TO LIMA / TRANSFER TO THE AIRPORT.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"696 characters\">&lt;/ul&gt;</span>
      \"\"\"
    \"<span class=sf-dump-key>detallado</span>\" => \"\"\"
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 01: ARRIVAL IN LIMA.&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Upon arriving at Lima airport, you will be greeted and transferred to your hotel. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Afternoon free to relax. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Overnight in Lima.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 02: LIMA - CITY TOUR OF COLONIAL AND MODERN AREAS&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After enjoying breakfast at the hotel, you will have the morning free to spend as you wish. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;The City Tour of Lima will start at 2:00 PM and conclude at 6:00 PM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;During the tour, we will visit charming places including the Huaca Pucllana archaeological complex, Plaza de Armas, Plaza San Mart&amp;iacute;n, the Government Palace, San Francisco Church, San Isidro, Miraflores, Love Park, and Larcomar. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;In the evening, you have the option to visit the Magic Water Circuit from 6:15 PM to 8:00 PM (additional costs not included), a delightful experience. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Overnight in Lima.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 03: FLIGHT FROM LIMA TO CUSCO / ARCHAEOLOGICAL CITY TOUR&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After breakfast at the hotel, we will pick you up and transfer you to the Lima airport. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Upon arrival at Cusco airport, you will be greeted and taken to your hotel. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We recommend reserving at least 2 hours upon arrival at the hotel to rest and acclimate to the altitude. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Morning free for acclimatization. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We will pick you up at the hotel at 1:30 PM to start the Archaeological City Tour, which will take place from 2:00 PM to 6:30 PM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;During the tour, we will visit the Qoricancha Temple as well as the impressive archaeological complexes of Sacsayhuam&amp;aacute;n, Qenqo, Pucapucara, and Tambomachay. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;At the end of the tour, we will drop you off near the Plaza de Armas in the center of Cusco. You will have the opportunity to dine in the area before returning to the hotel for the night. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Overnight in Cusco.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 04: CUSCO - SACRED VALLEY OF THE INCAS&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After breakfast at the hotel, we will pick you up at 8:15 AM to begin our journey through the Sacred Valley of the Incas around 8:40 AM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;In the Sacred Valley, we will explore the Corao and Pisac markets, where you can experience local culture and enjoy the unique atmosphere. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Next, we will visit the impressive Pisac archaeological complex and the charming Ollantaytambo archaeological park, which offer rich history and stunning views. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We will also have the opportunity to visit Chinchero and appreciate the Colonial Temple of Chinchero. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We will return to Cusco around 7:00 PM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Overnight in Cusco.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 05: CUSCO - MACHU PICCHU FULL DAY&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We will depart from your hotel at 4:00 AM for the transfer from Cusco to Ollantaytambo station. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Then, we will take the 6:10 AM train to Aguas Calientes. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Upon arrival at Aguas Calientes station at 7:40 AM, we will meet you and board the bus to Machu Picchu. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We will enjoy a 2-hour guided tour of Machu Picchu with our professional guide. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After the Machu Picchu tour, remember to stamp (if you wish) your passport. A great tip is to also bring your personal journal to stamp&amp;mdash;it looks fantastic! The stamp is located just before the turnstile leading into Machu Picchu. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After the visit to Machu Picchu, we will return by bus to Aguas Calientes. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;While waiting for the train back to Ollantaytambo, you will have the option to enjoy the region&amp;#39;s hot springs, providing a moment of relaxation. Additionally, you can visit the butterfly house, a charming place where you can appreciate various species of butterflies. It&amp;rsquo;s a unique opportunity to admire the beauty of nature during this incredible day (these two options are not included in the package). &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;At 6:20 PM, we will board the train from Aguas Calientes to Ollantaytambo, with an expected arrival at 8:15 PM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Upon arrival at the station, our team will be ready to meet you and take you back to Cusco, where you will spend the night. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Arrival in Cusco is expected around 10:00 PM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Rest and prepare for more memorable moments.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 06: CUSCO &amp;ndash; PUNO / SUN ROUTE&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After enjoying another delicious breakfast at the hotel, we will pick you up at 6:30 AM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;The bus will depart at 7:00 AM for a day full of fascinating visits along the Sun Route. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Our destinations include the charming Andahuaylillas Chapel, known as the &amp;quot;Sistine Chapel of the Americas,&amp;quot; the impressive Wiracocha Temple in Raqchi, a buffet lunch in Sicuani, the stunning mountainous region of La Raya, and the interesting Pucar&amp;aacute; Museum. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;In Andahuaylillas, you&amp;#39;ll have the opportunity to visit the chapel known for its ancient Cusco paintings and artwork. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;At the Wiracocha Temple, you&amp;#39;ll explore this ancient storage site where the Incas preserved their products using natural refrigeration, serving the Cusco valley. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;During the stop at La Raya, you&amp;rsquo;ll be treated to spectacular views of the mountains and snow-capped peaks, offering excellent photo opportunities. You might also spot a small inactive volcano. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;In the Pucar&amp;aacute; Museum, belonging to the pre-Inca culture, you can admire collections of ceramics and lithic artifacts, immersing yourself in the region&amp;#39;s history and culture. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Upon arriving in Puno, we will be waiting to receive you and transfer you to the hotel for the night.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 07: PUNO - LAKE TITICACA&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After breakfast at the hotel, we will pick you up at 7:00 AM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We will embark at 7:30 AM for an exciting journey on Lake Titicaca. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We will visit the famous Uros Floating Islands and the charming Taquile Island. During this experience, we will have the opportunity to interact with the local inhabitants, who will share their ancestral traditions and customs of this sacred lake. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Around 5:00 PM, we will return to Puno, where we will take you back to the hotel for the night. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Enjoy this time to relax and reflect on the wonders we&amp;#39;ve experienced at Lake Titicaca.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 08: PUNO - CUSCO&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;After enjoying breakfast at the hotel, we will be ready to pick you up at 7:30 AM and transfer you to the bus station. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;The bus will depart promptly at 8:00 AM. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;During the journey, you&amp;#39;ll have the opportunity to admire the impressive highland landscape between Puno and Cusco. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;This area is known for its natural beauty and local communities that preserve their ancestral traditions. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Around 3:00 PM, we will arrive in Cusco. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Upon alighting from the bus at the station, our team will be ready to receive you and take you to the hotel for the night. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Alternatively, instead of returning to Cusco by bus and then taking the Cusco / Lima flight, you might consider purchasing a direct flight from Juliaca (Puno) to Lima. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;This option may be faster and more convenient, depending on your itinerary and preferences. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;You can check flight prices and schedules online when planning your trip to Peru.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;h2&gt;DAY 09: FLIGHT FROM CUSCO TO LIMA / TRANSFER TO THE AIRPORT&lt;/h2&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Enjoy your last day in Cusco with a delicious breakfast at the hotel and some free hours to explore the city on your own. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;When it&amp;rsquo;s time to depart, our team will be ready to take you to the airport safely and comfortably. &amp;nbsp;&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;We recommend being ready for the transfer at least 2.5 hours before your flight departure time to avoid any unforeseen issues and ensure a smooth trip.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"8140 characters\">&lt;/ul&gt;</span>
      \"\"\"
