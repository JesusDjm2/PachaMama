      <span class=sf-dump-str title=\"751 characters\">&lt;h3&gt;RECOMMENDATIONS:&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Bring personal documents (passport or ID).&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Students should carry the International Student Identity Card (ISIC).&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Sunscreen for sunny weather.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Insect repellent for Machu Picchu.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Raincoat for rainy seasons.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Appropriate clothing for cold weather.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;An extra battery for your camera.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Obtain travel insurance: ASSIST CARD.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\">&lt;/ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\">&lt;h3&gt;OPTIONAL SERVICES:&lt;/h3&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;First Class Train, add $89 for Vistadome.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Entrance to Huayna Picchu, $30 (request in advance due to limited availability).&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Portuguese-speaking guide service.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Private service.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"751 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Option to choose other hotels.&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
