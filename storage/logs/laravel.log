    \"<span class=sf-dump-key>detallado</span>\" => \"\"\"
      <span class=sf-dump-str title=\"962 characters\">&lt;p&gt;This tour starts in the early hours of the day, between 8:00am and 10:00am, according to your preference. We will pick you up from your hotel and take you to the transportation that will take us on a guided visit to the &lt;strong&gt;Sacsayhuaman&lt;/strong&gt; fortress. Once we finish exploring this wonderful place, we will head to the restaurant reserved for lunch. After lunch, we will walk through the streets of Cusco and visit the main &lt;strong&gt;cathedral&lt;/strong&gt;, where we will learn about its interesting history and construction.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"962 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"962 characters\">&lt;p&gt;Next, we will visit the Qoricancha temple, where we can observe the blend of the ancient Inca and Spanish cultures in this beautiful building. We will end our tour with a visit to the Inka Museum, which will allow us to learn more about the ancient life and customs of the &lt;strong&gt;Inca Empire.&lt;/strong&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"962 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"962 characters\">&lt;p&gt;We will then return you to your hotel. The approximate duration of the tour is 6 hours.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"962 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"962 characters\">&lt;p&gt;&amp;nbsp;&lt;/p&gt;</span>
      \"\"\"
    \"<span class=sf-dump-key>incluidos</span>\" => \"\"\"
      <span class=sf-dump-str title=\"170 characters\">&lt;ul&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"170 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Private transportation&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"170 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Tour guide&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"170 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Entrance ticket to archaeological sites (BTG)&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"170 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Snack &amp;amp; water&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"170 characters\"><span class=\"sf-dump-default\">\\t</span>&lt;li&gt;Lunch&lt;/li&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"170 characters\">&lt;/ul&gt;</span>
      \"\"\"
    \"<span class=sf-dump-key>importante</span>\" => \"\"\"
      <span class=sf-dump-str title=\"194 characters\">&lt;p&gt;The Tourist Ticket (BTG) allows you to enter all the archaeological sites chosen for this tour and other archaeological sites located outside the city.&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"194 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"194 characters\">&lt;p&gt;All services are private.&lt;/p&gt;</span>
      \"\"\"
